.correction-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 30rpx calc(60rpx + env(safe-area-inset-bottom)); background: #f6f7f8; color: #20262c; }
.context-card,.issue-card,.input-card { overflow: hidden; border-radius: 24rpx; background: #fff; }
.context-card { padding: 26rpx; }
.context-title { margin-bottom: 12rpx; color: #20262c; font-size: 30rpx; font-weight: 700; }
.picker-row { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }
.picker-label { color: #707982; font-size: 25rpx; }
.picker-value { min-width: 260rpx; color: #303840; font-size: 27rpx; text-align: right; }
.chevron { margin-left: 10rpx; color: #a0a6ac; font-size: 34rpx; }
.divider { height: 1rpx; background: #edf0f2; }
.restroom-context { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-top: 12rpx; padding: 18rpx; border-radius: 16rpx; background: #f6f7f8; color: #59636d; font-size: 23rpx; line-height: 1.5; }
.access-text { flex: none; color: #8a6262; }
.section-title { margin: 28rpx 8rpx 16rpx; color: #747d86; font-size: 24rpx; }
.issue-row { display: flex; min-height: 92rpx; align-items: center; justify-content: space-between; padding: 0 26rpx; border-bottom: 1rpx solid #edf0f2; font-size: 27rpx; }
.issue-row:last-child { border-bottom: 0; }
.input-card { position: relative; padding: 22rpx 24rpx; }
.description-input { width: 100%; height: 190rpx; box-sizing: border-box; color: #303840; font-size: 27rpx; line-height: 1.55; }
.count-text { position: absolute; right: 24rpx; bottom: 18rpx; color: #a0a6ac; font-size: 21rpx; }
.single-input-card { min-height: 44rpx; }
.single-input-card input { font-size: 27rpx; }
.field-tip { display: block; margin: 10rpx 8rpx 0; color: #9aa1a8; font-size: 21rpx; }
.error-message { margin-top: 28rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #fff1f1; color: #b84646; font-size: 23rpx; line-height: 1.5; }
.submit-button { display: flex; height: 92rpx; align-items: center; justify-content: center; margin-top: 34rpx; border-radius: 20rpx; background: #d84a4a; color: #fff; font-size: 29rpx; font-weight: 600; }
.submit-button[disabled] { background: #d6d9dc; color: #fff; }
.submit-button::after { border: 0; }
.privacy-note { display: block; margin: 22rpx 10rpx 0; color: #9299a1; font-size: 20rpx; line-height: 1.6; }
