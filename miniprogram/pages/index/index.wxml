<view class="page">
  <view class="custom-nav" style="height: {{navigationBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <text class="custom-nav__title">Metro 洗手间</text>
  </view>
  <view class="home-content">
  <view class="control-card">
    <view class="control-row control-row--first">
      <view class="city-control" role="button" aria-label="当前城市{{cityName}}，点击选择城市" bindtap="onOpenCityPicker">
        <text>{{cityName}}</text>
      </view>
      <view class="line-control" bindtap="onOpenLinePicker" style="border-color: {{lineColor}}; color: {{lineTextColor}};">
        <text>{{lineName}}</text><view class="control-chevron" aria-hidden="true"><view class="control-chevron__mark"></view></view>
      </view>
    </view>
    <view class="control-row control-row--second {{locationStatus === 'nearest' || locationStatus === 'selectedNearby' || locationStatus === 'stationRequired' || locationStatus === 'lineRequired' ? 'control-row--location-wide' : ''}}">
      <view wx:if="{{locationStatus === 'lineRequired' || locationStatus === 'stationRequired'}}" class="origin-control origin-control--actionable" role="button" aria-label="{{locationStatus === 'stationRequired' ? '当前计算起点' : '待确认站点'}}{{locationStatus === 'stationRequired' ? originStationName : locationPendingStationName}}，{{locationLabel}}，{{locationActionLabel}}" bindtap="onLocationAction">
        <view class="origin-name-control">
          <text class="origin-name">{{locationStatus === 'stationRequired' ? originStationName : locationPendingStationName}}</text>
        </view>
        <view class="origin-mode origin-mode--{{locationStatus}}"><text>{{locationLabel}}</text><text class="origin-mode__action">｜{{locationActionLabel}}</text></view>
      </view>
      <view wx:else class="origin-control {{isManualAnchor ? 'origin-control--actionable' : ''}}">
        <view class="origin-name-control" role="button" aria-label="当前计算起点{{originStationName}}，{{!isManualAnchor && !showLocationAction ? locationLabel + '，' : ''}}{{locationStatus === 'nearest' ? '直线距离，到站路程未计入预计时间，' : ''}}点击选择站点" bindtap="onOpenStationPicker">
          <text class="origin-name">{{originStationName}}</text>
        </view>
        <text class="origin-separator">·</text>
        <view wx:if="{{isManualAnchor && locationStatus === 'locating'}}" class="origin-mode origin-mode--locating">
          <text>自选起点</text><text class="origin-mode__action">｜定位中…</text>
        </view>
        <view wx:elif="{{isManualAnchor}}" class="origin-mode origin-mode--manual" role="button" aria-label="当前为自选起点，点击恢复定位" bindtap="onRestoreSmartLocation">
          <text>自选起点</text><text class="origin-mode__action">｜恢复定位</text>
        </view>
        <view wx:elif="{{showLocationAction}}" class="origin-mode origin-mode--{{locationStatus}}" role="button" aria-label="{{locationLabel}}，{{locationActionLabel}}" bindtap="onLocationAction">
          <text>{{locationLabel}}</text><text class="origin-mode__action">｜{{locationActionLabel}}</text>
        </view>
        <view wx:else class="origin-mode origin-mode--{{locationStatus}}" aria-hidden="true">
          <text>{{locationLabel}}</text>
        </view>
      </view>
      <view class="direction-control" bindtap="onSwitchDirection">
        <text class="direction-label">{{directionLabel}}</text><text class="direction-switch">⇄</text>
      </view>
    </view>
    <view wx:if="{{showRouteSelector}}" class="route-switch">
      <view class="route-switch__current"><text class="route-switch__eyebrow">当前</text><text>{{currentRouteTerminal}}</text></view>
      <view class="route-switch__action" role="button" aria-label="当前线路终点{{currentRouteTerminal}}，{{alternateRouteActionLabel}}" data-route-id="{{alternateRouteId}}" bindtap="onSelectRoute" style="color: {{lineTextColor}};"><text>{{alternateRouteActionLabel}}</text><text class="route-switch__chevron">›</text></view>
    </view>
  </view>

  <view class="sync-bar sync-bar--{{syncTone}}">
    <view class="sync-bar__status"><text class="sync-bar__dot"></text><text class="sync-bar__message">{{syncMessage}}</text></view>
    <button class="sync-bar__action" aria-label="{{syncActionLabel}}数据" disabled="{{syncPhase === 'checking'}}" bindtap="onRefreshSync"><view class="sync-action__icon {{syncPhase === 'checking' ? 'sync-action__icon--spinning' : ''}}"></view><text class="sync-action__label">{{syncActionLabel}}</text></button>
  </view>

  <view class="wheel-heading"><text class="wheel-tip">点圆点定起点</text><text class="wheel-tip">横滑换线</text></view>
  <view class="station-wheel">
    <horizontal-drag-gesture-handler tag="wheel-horizontal" simultaneous-handlers="{{['wheel-vertical']}}" worklet:ongesture="onWheelHorizontalGesture">
      <vertical-drag-gesture-handler tag="wheel-vertical" simultaneous-handlers="{{['wheel-horizontal']}}" native-view="scroll-view">
        <scroll-view
        class="station-wheel-scroll"
        type="list"
        scroll-y
        enhanced
        bounces="{{true}}"
        show-scrollbar="{{false}}"
        cache-extent="5000"
        scroll-top="{{wheelScrollTop}}"
        binddragstart="onWheelDragStart"
        worklet:onscrollstart="onWheelScrollStart"
        worklet:onscrollupdate="onWheelScrollUpdate"
        worklet:onscrollend="onWheelScrollEnd"
        worklet:adjust-deceleration-velocity="adjustWheelDecelerationVelocity"
      >
      <view class="wheel-spacer wheel-spacer--top" list-item style="height: {{wheelTopSpacerHeight}}px;">
        <view wx:if="{{isLoopLine}}" class="loop-boundary loop-boundary--top" role="button" aria-label="环线首尾相接，点击前往上一站{{loopPreviousStationName}}" data-target-index="{{loopLastIndex}}" catchtap="onLoopBoundaryTap" style="height: {{wheelSlotHeight}}px;">
          <view class="loop-boundary__line" style="background-color: {{lineColor}};"></view><view class="loop-boundary__ring" style="border-color: {{lineColor}};"><view class="loop-boundary__arrow loop-boundary__arrow--forward" style="border-left-color: {{lineColor}};"></view><view class="loop-boundary__arrow loop-boundary__arrow--return" style="border-right-color: {{lineColor}};"></view></view><text class="loop-boundary__label">环线 · 首尾相接</text>
        </view>
        <view wx:else class="route-end-cap route-end-cap--top" aria-hidden="true" style="height: {{wheelSlotHeight}}px;"><view class="route-end-cap__line" style="background-color: {{lineColor}};"></view><view class="route-end-cap__marker" style="border-color: {{lineColor}};"><view class="route-end-cap__core" style="background-color: {{lineColor}};"></view></view></view>
      </view>
      <block wx:for="{{stations}}" wx:for-item="station" wx:key="id">
      <view list-item class="station-row station-motion-row" data-motion-index="{{index}}" style="height: {{wheelSlotHeight}}px;">
        <view class="track-column">
          <view class="track-line" style="background-color: {{lineColor}};"></view>
          <view wx:if="{{station.isSystemOrigin}}" class="location-pin" style="background-color: {{lineColor}};"><view class="location-pin__core"></view></view>
          <view wx:elif="{{station.isOrigin && isManualAnchor}}" class="location-pin location-pin--manual"><view class="location-pin__core"></view></view>
          <view wx:else class="station-dot" style="{{station.dotStyle}}"></view>
        </view>
        <view wx:if="{{!station.isSystemOrigin}}" class="station-anchor-hit" role="button" aria-label="将{{station.name}}设为计算起点" data-station-id="{{station.id}}" catchtap="onSetManualAnchor"></view>
        <view wx:if="{{station.incomingBranchHint}}" class="branch-switch-anchor">
          <view class="branch-switch-slot" role="button" aria-label="{{station.incomingBranchHint.actionLabel}}" data-route-id="{{station.incomingBranchHint.routeId}}" bindtap="onSelectRoute" hover-class="branch-switch-slot--pressed" hover-start-time="0" hover-stay-time="80">
            <view class="branch-switch-slot__diagonal" style="background-color: {{lineColor}};"></view><view class="branch-switch-slot__horizontal" style="background-color: {{lineColor}};"></view><view class="branch-switch-slot__label" style="color: {{lineTextColor}};"><text>{{station.incomingBranchHint.actionLabel}}</text><text class="branch-switch-slot__chevron">›</text></view>
          </view>
        </view>
        <view id="station-card-{{index}}" class="station-card-shell station-motion-card {{station.isActive ? 'station-card-shell--active' : ''}} {{station.isBeforeFocus ? 'station-card-shell--before-focus' : ''}} {{station.isAfterFocus ? 'station-card-shell--after-focus' : ''}}" data-motion-index="{{index}}">
          <view wx:if="{{station.transferSwipeRight}}" id="transfer-swipe-right-{{index}}" class="transfer-swipe-cue transfer-swipe-cue--left" aria-hidden="true" style="border-color: {{station.transferSwipeRight.lineColor}};"><text class="transfer-swipe-cue__action">右滑切至</text><text class="transfer-swipe-cue__line" style="color: {{station.transferSwipeRight.lineTextColor}};">{{station.transferSwipeRight.lineName}}</text></view>
          <view wx:if="{{station.transferSwipeLeft}}" id="transfer-swipe-left-{{index}}" class="transfer-swipe-cue transfer-swipe-cue--right" aria-hidden="true" style="border-color: {{station.transferSwipeLeft.lineColor}};"><text class="transfer-swipe-cue__action">左滑切至</text><text class="transfer-swipe-cue__line" style="color: {{station.transferSwipeLeft.lineTextColor}};">{{station.transferSwipeLeft.lineName}}</text></view>
          <view wx:if="{{station.dataState === 'unavailable'}}" class="unavailable-station-card">
            <text class="station-name">{{station.name}}</text>
            <view wx:if="{{station.transferLineOptions.length > 1}}" class="transfer-strip" role="text" aria-label="{{station.transferSummaryAriaLabel}}">
              <view class="transfer-list" aria-hidden="true"><view wx:for="{{station.transferLineOptions}}" wx:for-item="transferLine" wx:key="lineId" class="transfer-pill" style="border-color: {{transferLine.lineColor}}; color: {{transferLine.lineTextColor}};"><text>{{transferLine.lineName}}</text></view></view>
            </view>
            <view class="unavailable-message"><text class="unavailable-mark">!</text><text>数据暂不可用</text></view>
            <text class="unavailable-tip">请稍后重试，不将其视为无卫生间</text>
          </view>
          <view wx:elif="{{station.hasRestroom}}" class="station-card {{station.showReverse ? 'station-card--reverse' : ''}}" data-station-id="{{station.id}}" bindtap="onOpenRestroomDrawer" hover-class="station-card--pressed" hover-start-time="0" hover-stay-time="80">
            <view class="station-card__accessible-detail" role="button" aria-label="{{station.restroomAriaLabel}}" data-station-id="{{station.id}}" catchtap="onOpenRestroomDrawer"></view>
            <view class="station-card__header"><text class="station-name">{{station.name}}</text><view class="station-card__labels"><text wx:if="{{station.primaryRestroom.hasOperationalIssue}}" class="operational-label operational-label--{{station.primaryRestroom.restroomStatus}}">{{station.primaryRestroom.statusLabel}}</text><view class="restroom-status"><text>{{station.restroomCapsuleLabel}}</text></view><view wx:if="{{station.showReverse}}" class="reverse-indicator" aria-label="需调头"><view class="reverse-indicator__curve"><view class="reverse-indicator__arrow"></view></view></view></view></view>
            <view wx:if="{{station.transferLineOptions.length > 1}}" class="transfer-strip" role="text" aria-label="{{station.transferSummaryAriaLabel}}">
              <view class="transfer-list" aria-hidden="true"><view wx:for="{{station.transferLineOptions}}" wx:for-item="transferLine" wx:key="lineId" class="transfer-pill" style="border-color: {{transferLine.lineColor}}; color: {{transferLine.lineTextColor}};"><text>{{transferLine.lineName}}</text></view></view>
            </view>
            <view wx:if="{{station.primaryRestroom.hasOperationalIssue}}" class="operational-summary"><text>{{station.primaryRestroom.statusLabel}}</text><text wx:if="{{station.primaryRestroom.statusReason}}"> · {{station.primaryRestroom.statusReason}}</text></view>
            <view wx:else class="restroom-facts"><view class="restroom-facts__tags"><text wx:for="{{station.primaryRestroom.wayfindingTags}}" wx:for-item="tag" wx:key="label" class="restroom-fact restroom-fact--{{tag.tone}}">{{tag.label}}</text></view><text class="eta-label restroom-facts__eta" style="color: {{lineTextColor}};">{{station.primaryRestroom.etaLabel}}</text></view>
          </view>
          <view wx:else class="empty-station-card">
            <view class="empty-station-card__header"><text class="station-name">{{station.name}}</text><text class="empty-text">暂无卫生间记录</text></view>
            <view wx:if="{{station.transferLineOptions.length > 1}}" class="transfer-strip" role="text" aria-label="{{station.transferSummaryAriaLabel}}">
              <view class="transfer-list" aria-hidden="true"><view wx:for="{{station.transferLineOptions}}" wx:for-item="transferLine" wx:key="lineId" class="transfer-pill" style="border-color: {{transferLine.lineColor}}; color: {{transferLine.lineTextColor}};"><text>{{transferLine.lineName}}</text></view></view>
            </view>
          </view>
        </view>
      </view>
      </block>
      <view class="wheel-spacer wheel-spacer--bottom" list-item style="height: {{wheelBottomSpacerHeight}}px;">
        <view wx:if="{{isLoopLine}}" class="loop-boundary loop-boundary--bottom" role="button" aria-label="环线首尾相接，点击回到下一站{{loopNextStationName}}" data-target-index="0" catchtap="onLoopBoundaryTap" style="height: {{wheelSlotHeight}}px;">
          <view class="loop-boundary__line" style="background-color: {{lineColor}};"></view><view class="loop-boundary__ring" style="border-color: {{lineColor}};"><view class="loop-boundary__arrow loop-boundary__arrow--forward" style="border-left-color: {{lineColor}};"></view><view class="loop-boundary__arrow loop-boundary__arrow--return" style="border-right-color: {{lineColor}};"></view></view><text class="loop-boundary__label">继续循环</text>
        </view>
        <view wx:else class="route-end-cap route-end-cap--bottom" aria-hidden="true" style="height: {{wheelSlotHeight}}px;"><view class="route-end-cap__line" style="background-color: {{lineColor}};"></view><view class="route-end-cap__marker" style="border-color: {{lineColor}};"><view class="route-end-cap__core" style="background-color: {{lineColor}};"></view></view></view>
      </view>
        </scroll-view>
      </vertical-drag-gesture-handler>
    </horizontal-drag-gesture-handler>
  </view>
  </view>

  <view wx:if="{{showCityPicker}}" class="overlay" bindtap="onCloseCityPicker">
    <view class="picker-sheet city-picker-sheet" catchtap="onStopPropagation"><view class="sheet-handle"></view><view class="sheet-title">选择城市</view>
      <view class="city-picker-item" role="button" aria-label="上海，当前城市" bindtap="onSelectCity"><text class="city-picker-name">上海</text><text class="city-picker-current">当前城市</text></view>
      <text class="city-picker-note">更多城市陆续开放</text>
    </view>
  </view>
  <view wx:if="{{showLinePicker}}" class="overlay" bindtap="onCloseLinePicker">
    <view class="picker-sheet" role="dialog" aria-label="{{isManualSelectionGuide ? '先选择线路' : '选择浏览线路'}}" catchtap="onStopPropagation"><view class="sheet-handle"></view><view class="sheet-title">{{isManualSelectionGuide ? '先选择线路' : '选择浏览线路'}}</view>
      <scroll-view class="line-picker-list" type="list" scroll-y><view class="line-picker-grid" list-item><view wx:for="{{lineOptions}}" wx:for-item="line" wx:key="id" class="line-picker-pill {{line.id === lineId ? 'line-picker-pill--selected' : ''}}" data-line-id="{{line.id}}" bindtap="onSelectLine" style="border-color: {{line.color}}; color: {{line.textColor}};"><text class="line-picker-pill__mark" style="background-color: {{line.color}};"></text><text class="line-picker-pill__name">{{line.name}}</text><text wx:if="{{line.id === lineId}}" class="line-picker-pill__current">当前</text></view></view></scroll-view>
    </view>
  </view>
  <view wx:if="{{showStationPicker}}" class="overlay" bindtap="onCloseStationPicker">
    <view class="picker-sheet" role="dialog" aria-label="{{isManualSelectionGuide ? '再选择起点站' : '选择计算起点'}}" catchtap="onStopPropagation"><view class="sheet-handle"></view><view wx:if="{{isManualSelectionGuide}}" class="manual-station-header"><view class="sheet-title">再选择起点站</view><view class="manual-station-back" role="button" aria-label="返回选择线路" bindtap="onBackToManualLinePicker">上一步</view></view><view wx:else class="sheet-title">选择计算起点</view><text class="sheet-subtitle">选择后将切换为自选起点</text>
      <scroll-view wx:if="{{isManualSelectionGuide}}" class="picker-list" type="list" scroll-y><view wx:for="{{manualStationOptions}}" wx:for-item="station" wx:key="id" list-item class="manual-station-option"><text wx:if="{{station.sectionLabel}}" class="manual-station-section">{{station.sectionLabel}}</text><view class="picker-item manual-station-item {{station.id === originStationId ? 'picker-item--selected' : ''}}" role="button" aria-label="{{station.name}}{{station.branchRoleLabel ? '，' + station.branchRoleLabel : ''}}{{station.contextLabel ? '，' + station.contextLabel : ''}}" data-station-id="{{station.id}}" data-route-id="{{station.routeId}}" bindtap="onSelectOriginStation"><view class="manual-station-copy"><text class="manual-station-name">{{station.name}}</text><text wx:if="{{station.contextLabel}}" class="manual-station-meta"> · {{station.contextLabel}}</text></view><text wx:if="{{station.id === originStationId}}" class="selected-mark">✓</text></view></view></scroll-view>
      <scroll-view wx:else class="picker-list" type="list" scroll-y><view wx:for="{{stations}}" wx:for-item="station" wx:key="id" list-item class="picker-item {{station.id === originStationId ? 'picker-item--selected' : ''}}" data-station-id="{{station.id}}" bindtap="onSelectOriginStation"><text>{{station.name}}</text><text wx:if="{{station.id === originStationId}}" class="selected-mark">✓</text></view></scroll-view>
    </view>
  </view>
  <view wx:if="{{showLocationCandidates}}" class="overlay" bindtap="onCloseLocationCandidates">
    <view class="picker-sheet location-sheet" role="dialog" aria-label="为{{locationPendingStationName}}选择起始线路" catchtap="onStopPropagation"><view class="sheet-handle"></view><view class="location-sheet__header"><view class="sheet-title">选择起始线路</view><view class="location-sheet__close" role="button" aria-label="关闭线路选择，不更改起点" catchtap="onCloseLocationCandidates">×</view></view><text class="sheet-subtitle">{{locationPendingStationName}} · 距你{{locationPendingDistanceLabel}}，选择后才会更新计算起点</text>
      <scroll-view class="picker-list location-candidate-list" style="height: {{locationCandidates.length * 112}}rpx;" type="list" scroll-y><view wx:for="{{locationCandidates}}" wx:for-item="candidate" wx:key="lineStationId" list-item class="picker-item location-candidate" role="button" aria-label="从{{candidate.lineName}}开始计算" data-station-id="{{candidate.lineStationId}}" bindtap="onSelectLocationCandidate"><view><text class="candidate-station">{{candidate.lineName}}</text><text class="candidate-line">选择此线路</text></view></view></scroll-view>
      <view class="location-manual-action" role="button" aria-label="选择其他线路和起点站" bindtap="onChooseManualLocation">选择其他</view>
    </view>
  </view>
  <view wx:if="{{showNearbyStationPicker}}" class="overlay" bindtap="onCloseNearbyStationPicker">
    <view class="picker-sheet location-sheet" role="dialog" aria-label="选择定位点五公里内的附近站" catchtap="onStopPropagation"><view class="sheet-handle"></view><view class="location-sheet__header"><view class="sheet-title">选择附近站</view><view class="location-sheet__close" role="button" aria-label="关闭附近站选择，不更改起点" catchtap="onCloseNearbyStationPicker">×</view></view><text class="sheet-subtitle">5 公里内的站点，按直线距离由近到远</text>
      <scroll-view class="picker-list location-candidate-list" style="height: {{nearbyStationCandidates.length * 112}}rpx;" type="list" scroll-y><view wx:for="{{nearbyStationCandidates}}" wx:for-item="candidate" wx:key="physicalStationId" list-item class="picker-item location-candidate" role="button" aria-label="选择{{candidate.stationName}}，{{candidate.lineNames}}，直线距离{{candidate.distanceLabel}}" data-physical-station-id="{{candidate.physicalStationId}}" bindtap="onSelectNearbyStation"><view><text class="candidate-station">{{candidate.stationName}}</text><text class="candidate-line">{{candidate.lineNames}}</text></view><text class="candidate-distance">{{candidate.distanceLabel}}</text></view></scroll-view>
      <view class="location-manual-action" role="button" aria-label="选择其他线路和起点站" bindtap="onChooseManualLocation">选择其他</view>
    </view>
  </view>
  <view wx:if="{{showRestroomDrawer}}" class="overlay" bindtap="onCloseRestroomDrawer">
    <view class="drawer-sheet" catchtap="onStopPropagation"><view class="sheet-handle"></view>
      <view class="drawer-header"><view><view class="sheet-title">{{drawerStation.name}}</view><text class="drawer-count">卫生间位置信息 · 完整来源描述</text></view><text class="drawer-close" bindtap="onCloseRestroomDrawer">×</text></view>
      <scroll-view class="drawer-list" type="list" scroll-y>
        <view wx:for="{{drawerGroups}}" wx:for-item="group" wx:key="lineId" list-item class="drawer-group">
          <view class="drawer-group__header"><text class="drawer-group__mark" style="background-color: {{group.lineColor}};"></text><text class="drawer-group__name">{{group.lineName}}</text><text wx:if="{{group.isCurrent}}" class="drawer-group__current">当前线路</text></view>
          <view wx:for="{{group.restrooms}}" wx:for-item="restroom" wx:for-index="restroomIndex" wx:key="id" class="drawer-item">
            <view class="drawer-item__top {{!group.isCurrent && restroomIndex === 0 ? 'drawer-item__top--switchable' : ''}}"><text wx:if="{{restroom.hasOperationalIssue}}" class="operational-label operational-label--{{restroom.restroomStatus}}">{{restroom.statusLabel}}</text><text wx:else class="eta-label" style="color: {{group.lineTextColor}};">{{restroom.etaLabel}}</text></view>
            <view wx:if="{{!group.isCurrent && restroomIndex === 0}}" class="drawer-item__switch" role="button" aria-label="切换至{{group.lineName}}" data-line-id="{{group.lineId}}" data-station-id="{{group.stationId}}" catchtap="onSelectDrawerLine" hover-class="drawer-item__switch--pressed" hover-start-time="0" hover-stay-time="80">切换 ›</view>
            <text wx:if="{{restroom.statusReason}}" class="drawer-status-reason">{{restroom.statusReason}}</text><view class="drawer-facts"><text wx:for="{{restroom.wayfindingTags}}" wx:for-item="tag" wx:key="label" class="restroom-fact restroom-fact--{{tag.tone}}">{{tag.label}}</text></view><text class="drawer-location">完整位置：{{restroom.detailLocation || '具体位置待补充'}}</text><text class="drawer-access">来源闸区：{{restroom.access || '未标注'}}</text>
            <text class="drawer-feedback-link" data-station-id="{{restroom.stationId}}" data-restroom-id="{{restroom.id}}" catchtap="onCorrectRestroom">信息有误？反馈</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
