var FOCUS_SCALE_X = 0.065;
var FOCUS_SCALE_Y = 0.055;
var FOCUS_PUSH_RPX = 14;
var MOTION_RADIUS = 2.001;

function clamp(value, min, max) {
  return Math.min(Math.max(value, min), max);
}

function round(value, digits) {
  var factor = Math.pow(10, digits || 0);
  return Math.round(value * factor) / factor;
}

function smoothstep(value) {
  var progress = clamp(value, 0, 1);
  return progress * progress * (3 - (2 * progress));
}

function getFocusStrength(distance) {
  var offset = Math.abs(distance || 0);
  if (offset >= 1) return 0;
  return (1 + Math.cos(Math.PI * offset)) / 2;
}

function getDistanceFromCenters(cardCenterY, focusCenterY, slotHeight) {
  if (!(slotHeight > 0)) return 0;
  return (cardCenterY - focusCenterY) / slotHeight;
}

function isFocusCandidate(stationIndex, anchorIndex) {
  return Math.abs(stationIndex - anchorIndex) <= 1;
}

function getCardMotion(distance) {
  var offset = distance || 0;
  var absoluteOffset = Math.abs(offset);
  var focus = getFocusStrength(offset);
  var pushProgress = smoothstep(clamp(1 - Math.abs(absoluteOffset - 1), 0, 1));
  return {
    focus: round(focus, 6),
    scaleX: round(1 + (FOCUS_SCALE_X * focus), 6),
    scaleY: round(1 + (FOCUS_SCALE_Y * focus), 6),
    translateY: round((offset < 0 ? -1 : (offset > 0 ? 1 : 0)) * FOCUS_PUSH_RPX * pushProgress, 6),
  };
}

function getMotionState(instance) {
  var state = instance.getState();
  if (typeof state.settledIndex !== 'number') state.settledIndex = 0;
  return state;
}

function getMotionIndex(element) {
  var dataset = element && element.getDataset ? (element.getDataset() || {}) : {};
  var index = +dataset.motionIndex;
  return index === index ? index : null;
}

function getMotionElements(ownerInstance, state) {
  if (state.motionElements) return state.motionElements;

  var rows = ownerInstance.selectAllComponents('.station-motion-row') || [];
  var cards = ownerInstance.selectAllComponents('.station-motion-card') || [];
  var byIndex = {};
  var index;

  for (index = 0; index < rows.length; index += 1) {
    var rowIndex = getMotionIndex(rows[index]);
    if (rowIndex === null) continue;
    if (!byIndex[rowIndex]) byIndex[rowIndex] = {};
    byIndex[rowIndex].row = rows[index];
  }

  for (index = 0; index < cards.length; index += 1) {
    var cardIndex = getMotionIndex(cards[index]);
    if (cardIndex === null) continue;
    if (!byIndex[cardIndex]) byIndex[cardIndex] = {};
    byIndex[cardIndex].card = cards[index];
  }

  state.motionElements = {
    byIndex: byIndex,
    cards: cards,
  };
  return state.motionElements;
}

function getCenterY(element) {
  if (!element || !element.getBoundingClientRect) return null;
  var rect = element.getBoundingClientRect();
  if (!rect || !(rect.height > 0)) return null;
  return rect.top + (rect.height / 2);
}

function clearCardStyle(card) {
  card.setStyle({
    transform: '',
    'transform-origin': '',
    'z-index': '',
  });
}

function clearMotionStyles(ownerInstance, instance, state) {
  var motionState = state || getMotionState(instance);
  var cards = getMotionElements(ownerInstance, motionState).cards || [];
  for (var index = 0; index < cards.length; index += 1) {
    clearCardStyle(cards[index]);
  }
  motionState.motionElements = null;
}

function captureFocusGeometry(ownerInstance, state) {
  var elements = getMotionElements(ownerInstance, state).byIndex;
  var focusElement = elements[state.settledIndex];
  var focusCenterY = focusElement && getCenterY(focusElement.row);
  if (focusCenterY === null || focusCenterY === undefined) return false;

  var totalSlotHeight = 0;
  var measuredSlots = 0;
  for (var direction = -1; direction <= 1; direction += 2) {
    var adjacent = elements[state.settledIndex + direction];
    var adjacentCenterY = adjacent && getCenterY(adjacent.row);
    if (adjacentCenterY === null || adjacentCenterY === undefined) continue;
    var measuredHeight = Math.abs(adjacentCenterY - focusCenterY);
    if (!(measuredHeight > 0)) continue;
    totalSlotHeight += measuredHeight;
    measuredSlots += 1;
  }

  if (!measuredSlots) return false;
  state.focusCenterY = focusCenterY;
  state.slotHeight = totalSlotHeight / measuredSlots;
  return true;
}

function applyMeasuredMotion(ownerInstance, instance, state) {
  if (!(state.slotHeight > 0)
    || state.focusCenterY === undefined
    || state.focusCenterY === null) {
    if (!captureFocusGeometry(ownerInstance, state)) return;
  }

  var elements = getMotionElements(ownerInstance, state).byIndex;
  var startIndex = Math.max(state.anchorIndex - 2, 0);
  var endIndex = state.anchorIndex + 2;

  for (var stationIndex = startIndex; stationIndex <= endIndex; stationIndex += 1) {
    var element = elements[stationIndex];
    if (!element || !element.row || !element.card) continue;
    var centerY = getCenterY(element.row);
    if (centerY === null || centerY === undefined) continue;
    var distance = getDistanceFromCenters(centerY, state.focusCenterY, state.slotHeight);
    var motion = Math.abs(distance) <= MOTION_RADIUS
      ? getCardMotion(distance)
      : getCardMotion(MOTION_RADIUS);
    if (!isFocusCandidate(stationIndex, state.anchorIndex)) {
      motion.focus = 0;
      motion.scaleX = 1;
      motion.scaleY = 1;
    }
    element.card.setStyle({
      transform: 'translateY(' + motion.translateY + 'rpx) scale3d(' + motion.scaleX + ',' + motion.scaleY + ',1)',
      'transform-origin': 'left center',
      'z-index': motion.focus > 0 ? '3' : '2',
    });
  }
}

function beginMotion(ownerInstance, instance, state) {
  var dataset = instance.getDataset() || {};
  var currentIndex = +dataset.currentIndex;
  if (currentIndex === currentIndex) state.settledIndex = currentIndex;
  state.anchorIndex = state.settledIndex;
  state.motionActive = true;
  state.motionElements = null;
  captureFocusGeometry(ownerInstance, state);
}

function scheduleMotion(ownerInstance, instance, state) {
  if (state.framePending) return;
  state.framePending = true;
  instance.requestAnimationFrame(function () {
    state.framePending = false;
    if (!state.motionActive) return;
    applyMeasuredMotion(ownerInstance, instance, state);
  });
}

/**
 * transition 与 touchmove 只负责通知视图刷新。
 * 动效进度统一取 station-row 的真实屏幕中心，不再混用两套 dy 坐标。
 */
function onTransition(event, ownerInstance) {
  var instance = event.instance;
  var state = getMotionState(instance);
  if (!state.motionActive) beginMotion(ownerInstance, instance, state);
  scheduleMotion(ownerInstance, instance, state);
}

function onTouchStart(event, ownerInstance) {
  var instance = event.instance;
  var state = getMotionState(instance);
  beginMotion(ownerInstance, instance, state);
  state.touchActive = true;
}

function onTouchMove(event, ownerInstance) {
  var instance = event.instance;
  var state = getMotionState(instance);
  if (!state.touchActive) return;
  scheduleMotion(ownerInstance, instance, state);
}

function onTouchEnd(event) {
  var instance = event.instance;
  var state = getMotionState(instance);
  state.touchActive = false;
}

function onAnimationFinish(event, ownerInstance) {
  var instance = event.instance;
  var state = getMotionState(instance);
  var detail = event.detail || {};
  var currentIndex = detail.current;
  if (currentIndex === undefined || currentIndex === null) currentIndex = state.settledIndex;
  currentIndex = +currentIndex;
  if (state.motionActive) applyMeasuredMotion(ownerInstance, instance, state);
  state.motionActive = false;
  state.touchActive = false;
  ownerInstance.callMethod('onStationAnimationFinish', {
    currentIndex: currentIndex,
    source: detail.source || '',
  });
}

function onSettledStateChange(newValue, oldValue, ownerInstance, instance) {
  var swiper = ownerInstance.selectComponent('.station-swiper');
  if (!swiper) return;
  var state = getMotionState(swiper);
  var dataset = swiper.getDataset() || {};
  var currentIndex = +dataset.currentIndex;
  state.settledIndex = currentIndex === currentIndex ? currentIndex : 0;
  state.anchorIndex = state.settledIndex;
  state.motionActive = false;
  state.touchActive = false;
  state.focusCenterY = undefined;
  state.slotHeight = 0;
  clearMotionStyles(ownerInstance, swiper, state);
  swiper.requestAnimationFrame(function () {
    captureFocusGeometry(ownerInstance, state);
  });
}

module.exports = {
  getCardMotion: getCardMotion,
  getDistanceFromCenters: getDistanceFromCenters,
  getFocusStrength: getFocusStrength,
  isFocusCandidate: isFocusCandidate,
  onAnimationFinish: onAnimationFinish,
  onSettledStateChange: onSettledStateChange,
  onTouchEnd: onTouchEnd,
  onTouchMove: onTouchMove,
  onTouchStart: onTouchStart,
  onTransition: onTransition,
};
