.selected-mark { font-size: 30rpx; }
.sheet-subtitle { display: block; margin-top: 10rpx; color: #66717b; font-size: 23rpx; line-height: 1.5; }
.manual-station-header { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; margin: -12rpx 0 -8rpx; }
