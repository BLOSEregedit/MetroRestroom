.city-picker-current { padding: 4rpx 12rpx; border-radius: 999rpx; background: #e8f2ff; color: #007aff; font-size: 20rpx; }
.city-picker-note { display: block; margin-top: 22rpx; color: #929aa2; font-size: 22rpx; text-align: center; }
.picker-list { height: 55vh; max-height: 55vh; margin-top: 18rpx; }
.picker-item { display: flex; min-height: 94rpx; align-items: center; justify-content: space-between; box-sizing: border-box; border-bottom: 1rpx solid #eef0f2; color: #58616a; font-size: 28rpx; }
