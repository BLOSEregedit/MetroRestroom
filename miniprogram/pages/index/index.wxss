.page { background: #f6f7f8; color: #1f2429; }
.page { display: flex; height: 100vh; min-height: 0; box-sizing: border-box; flex-direction: column; overflow: hidden; padding: 28rpx 28rpx calc(116rpx + env(safe-area-inset-bottom)); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.control-card { position: relative; z-index: 2; padding: 26rpx 28rpx 22rpx; border: 1rpx solid rgba(24,32,40,.07); border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 12rpx 40rpx rgba(33,42,52,.08); }
.control-row { display: flex; align-items: center; justify-content: space-between; }
.control-row--second { margin-top: 22rpx; }
.control-row--mode { margin-top: 20rpx; }
.city-name { color: #6f7780; font-size: 26rpx; letter-spacing: 1rpx; }
.line-control,.direction-control,.origin-control,.mode-control { display: flex; align-items: center; }
.line-control { gap: 8rpx; padding: 7rpx 14rpx; border: 2rpx solid; border-radius: 999rpx; font-size: 25rpx; font-weight: 600; }
.control-chevron { font-size: 24rpx; line-height: 1; }
.origin-control { flex-direction: column; align-items: flex-start; }
.origin-name { font-size: 37rpx; font-weight: 700; letter-spacing: .5rpx; }
.origin-caption { margin-top: 4rpx; color: #8d959d; font-size: 22rpx; }
.direction-control { max-width: 46%; gap: 14rpx; padding: 12rpx 14rpx 12rpx 18rpx; border-radius: 16rpx; background: #f2f4f5; }
.direction-label { overflow: hidden; color: #49525b; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.direction-switch { color: #1f2429; font-size: 32rpx; line-height: 1; }
.mode-control { gap: 10rpx; color: #77808a; font-size: 23rpx; }
.mode-control--manual { color: #c94646; }
.mode-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #29a36a; }
.mode-control--notRequested .mode-dot,.mode-control--cached .mode-dot,.mode-control--unavailable .mode-dot { background: #98a0a8; }
.mode-control--locating .mode-dot { background: #d39a35; }
.mode-control--ambiguous .mode-dot,.mode-control--unmatched .mode-dot,.mode-control--failed .mode-dot { background: #d28b31; }
.mode-control--denied .mode-dot { background: #cf5b5b; }
.mode-action { margin-left: 8rpx; padding-left: 14rpx; border-left: 1rpx solid rgba(201,70,70,.3); }
.route-selector { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.route-selector__content { display: inline-flex; gap: 12rpx; padding-right: 20rpx; }
.route-pill { display: inline-flex; min-height: 54rpx; align-items: center; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #d8dde1; border-radius: 999rpx; background: #f6f7f8; color: #69727b; font-size: 22rpx; }
.route-pill--selected { border-color: currentColor; background: #fff; color: #cf4d4d; font-weight: 600; }
.wheel-heading { display: flex; justify-content: space-between; margin: 34rpx 10rpx 12rpx; color: #59626c; font-size: 25rpx; }
.wheel-tip { color: #9ba2a9; font-size: 21rpx; }
.station-swiper { height: auto; min-height: 450rpx; flex: 1; }
.station-row { display: flex; align-items: center; height: 100%; opacity: .42; transform: scale(.96); transition: opacity 160ms ease,transform 160ms ease; }
.station-row--active { opacity: 1; transform: scale(1.03); }
.track-column { position: relative; display: flex; width: 72rpx; align-self: stretch; align-items: center; justify-content: center; }
.track-line { position: absolute; top: 0; bottom: 0; left: 34rpx; width: 5rpx; opacity: .72; }
.station-dot { position: relative; z-index: 1; display: flex; width: 24rpx; height: 24rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 5rpx solid; border-radius: 50%; background: #f6f7f8; }
.station-dot--system { border-color: transparent !important; }
.station-dot--anchor { width: 32rpx; height: 32rpx; border: 0; background: #df4c4c; box-shadow: 0 3rpx 10rpx rgba(185,49,49,.25); }
.pin-mark { color: #fff; font-size: 15rpx; }
.station-card,.empty-station-card,.unavailable-station-card { width: calc(100% - 72rpx); box-sizing: border-box; border-radius: 24rpx; }
.station-card { min-height: 204rpx; padding: 24rpx 26rpx 20rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(36,47,58,.1); }
.station-card--reverse { border: 1rpx solid #d8dce0; background: #f7f8f9; }
.station-card__header,.restroom-summary,.restroom-meta,.view-all,.drawer-item__top,.drawer-header { display: flex; align-items: center; justify-content: space-between; }
.station-name { font-size: 31rpx; font-weight: 700; }
.reverse-label { color: #858e98; font-size: 21rpx; }
.restroom-summary { justify-content: flex-start; gap: 8rpx; margin-top: 14rpx; color: #636d77; font-size: 24rpx; }
.eta-label { color: #e05858; font-weight: 700; }
.restroom-meta { justify-content: flex-start; gap: 12rpx; margin-top: 12rpx; color: #7c858f; font-size: 22rpx; }
.restroom-meta__item + .restroom-meta__item { padding-left: 12rpx; border-left: 1rpx solid #d9dde0; }
.restroom-feedback-link { margin-left: auto; color: #bd5555; }
.view-all { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #edf0f2; color: #5c6771; font-size: 22rpx; }
.empty-station-card { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; padding: 22rpx 26rpx; background: #e8ebed; }
.empty-text { color: #929aa2; font-size: 22rpx; }
.unavailable-station-card { min-height: 164rpx; padding: 24rpx 26rpx; border: 2rpx solid #e4b254; background: #fffaf0; }
.unavailable-station-card--active { box-shadow: 0 8rpx 24rpx rgba(176, 128, 35, .12); }
.unavailable-message { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; color: #9a6b19; font-size: 25rpx; font-weight: 600; }
.unavailable-mark { display: inline-flex; width: 26rpx; height: 26rpx; align-items: center; justify-content: center; border-radius: 50%; background: #dca742; color: #fff; font-size: 19rpx; }
.unavailable-tip { display: block; margin-top: 10rpx; color: #9c8b68; font-size: 21rpx; }
.overlay { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(24,31,37,.38); }
.picker-sheet,.drawer-sheet { width: 100%; box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; background: #fff; }
.picker-sheet { max-height: 70vh; padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); }
.drawer-sheet { max-height: 72vh; padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); }
.sheet-handle { width: 66rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 99rpx; background: #d9dee1; }
.sheet-title { color: #20262c; font-size: 32rpx; font-weight: 700; }
.picker-list { max-height: 55vh; margin-top: 18rpx; }
.picker-item { display: flex; min-height: 94rpx; align-items: center; justify-content: space-between; box-sizing: border-box; border-bottom: 1rpx solid #eef0f2; color: #58616a; font-size: 28rpx; }
.picker-item--selected { color: #d84d4d; font-weight: 700; }
.selected-mark { font-size: 30rpx; }
.sheet-subtitle { display: block; margin-top: 10rpx; color: #858d95; font-size: 23rpx; line-height: 1.5; }
.location-sheet { max-height: 72vh; }
.location-candidate-list { max-height: 45vh; }
.location-candidate { min-height: 112rpx; }
.candidate-station,.candidate-line { display: block; }
.candidate-station { color: #2c333a; font-size: 29rpx; font-weight: 700; }
.candidate-line { margin-top: 8rpx; color: #7c858e; font-size: 22rpx; }
.candidate-distance { color: #9a6262; font-size: 22rpx; }
.location-manual-action { display: flex; min-height: 82rpx; align-items: center; justify-content: center; margin-top: 8rpx; border-top: 1rpx solid #edf0f2; color: #66717b; font-size: 25rpx; }
.drawer-header { align-items: flex-start; }
.drawer-count { display: block; margin-top: 6rpx; color: #8b939b; font-size: 23rpx; }
.drawer-close { padding: 0 8rpx; color: #747e88; font-size: 46rpx; line-height: 1; }
.drawer-list { max-height: 53vh; margin-top: 22rpx; }
.drawer-item { margin-bottom: 16rpx; padding: 22rpx; border-radius: 18rpx; background: #f6f7f8; }
.facility-label { padding: 4rpx 10rpx; border-radius: 999rpx; background: #e7ebee; color: #64707a; font-size: 20rpx; }
.drawer-location,.drawer-access { display: block; margin-top: 10rpx; color: #5f6871; font-size: 24rpx; }
.drawer-access { color: #8a929a; font-size: 22rpx; }
.drawer-item__actions { display: flex; align-items: center; gap: 18rpx; }
.drawer-feedback-link { color: #bd5555; font-size: 22rpx; }
