.page { display: flex; height: 100vh; min-height: 0; box-sizing: border-box; flex-direction: column; overflow: hidden; background: #f6f7f8; color: #1f2429; font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif; }
.custom-nav { display: flex; width: 100%; flex: none; align-items: center; justify-content: center; box-sizing: border-box; background: #f6f7f8; }
.custom-nav__title { color: #15191d; font-size: 30rpx; font-weight: 500; }
.home-content { display: flex; min-height: 0; flex: 1; box-sizing: border-box; flex-direction: column; overflow: hidden; padding: 8rpx 28rpx 16rpx; }
.control-card { position: relative; z-index: 2; padding: 14rpx 22rpx 12rpx; border: 1rpx solid rgba(24,32,40,.07); border-radius: 28rpx; background: rgba(255,255,255,.96); box-shadow: 0 12rpx 40rpx rgba(33,42,52,.08); }
.control-row { display: flex; align-items: center; justify-content: space-between; }
.control-row--first { min-height: 58rpx; }
.control-row--second { min-height: 64rpx; margin-top: 6rpx; }
.city-control,.line-control,.direction-control,.origin-control,.origin-mode { display: flex; align-items: center; }
.city-control { min-height: 50rpx; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #dde2e6; border-radius: 999rpx; background: #f1f3f5; color: #4f5963; font-size: 25rpx; font-weight: 600; letter-spacing: 1rpx; }
.line-control { gap: 8rpx; padding: 7rpx 14rpx; border: 2rpx solid; border-radius: 999rpx; font-size: 25rpx; font-weight: 600; }
.control-chevron { display: flex; width: 20rpx; height: 20rpx; flex: none; align-items: center; justify-content: center; }
.control-chevron__mark { width: 9rpx; height: 9rpx; box-sizing: border-box; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: translateY(-2rpx) rotate(45deg); }
.origin-control { min-width: 0; flex: 1; overflow: hidden; }
.origin-control--actionable { min-height: 88rpx; }
.origin-name-control { min-width: 0; overflow: hidden; flex: 0 1 auto; }
.origin-name { display: block; overflow: hidden; color: #1f2429; font-size: 34rpx; font-weight: 700; letter-spacing: .5rpx; text-overflow: ellipsis; white-space: nowrap; }
.origin-separator { flex: none; margin: 0 8rpx; color: #b0b6bc; font-size: 24rpx; }
.origin-mode { min-width: 0; flex: none; color: #77808a; font-size: 21rpx; white-space: nowrap; }
.origin-mode--manual { color: #007aff; }
.origin-mode--locating { color: #9a6b19; }
.origin-mode--stationRequired,.origin-mode--lineRequired,.origin-mode--unmatched,.origin-mode--failed { color: #956517; }
.origin-mode--denied { color: #aa4747; }
.origin-mode__action { font-weight: 600; }
.origin-mode--stationRequired .origin-mode__action,.origin-mode--lineRequired .origin-mode__action { color: #007aff; }
.control-row--location-wide .origin-control { align-items: flex-start; justify-content: center; flex-direction: column; }
.control-row--location-wide .origin-name-control { max-width: 100%; flex: none; }
.control-row--location-wide .origin-separator { display: none; }
.control-row--location-wide .origin-mode { margin-top: 2rpx; }
.control-row--location-wide .direction-control { max-width: 32%; }
.direction-control { max-width: 43%; flex: none; gap: 10rpx; margin-left: 16rpx; padding: 9rpx 11rpx 9rpx 14rpx; border-radius: 16rpx; background: #f2f4f5; }
.direction-label { overflow: hidden; color: #49525b; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.direction-switch { color: #1f2429; font-size: 32rpx; line-height: 1; }
.sync-bar { display: flex; min-height: 52rpx; align-items: center; justify-content: space-between; margin: 6rpx 8rpx 0; color: #77808a; font-size: 21rpx; }
.sync-bar__status { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.sync-bar__message { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sync-bar__dot { width: 12rpx; height: 12rpx; flex: none; border-radius: 50%; background: #007aff; }
.sync-bar--green .sync-bar__dot { background: #29a36a; }
.sync-bar--blue .sync-bar__dot { background: #007aff; }
.sync-bar__action { display: flex; min-width: 96rpx; min-height: 52rpx; flex: none; align-items: center; justify-content: flex-end; gap: 8rpx; margin: 0 0 0 16rpx; padding: 0; border: 0; border-radius: 0; background: transparent; color: #007aff; font-size: 21rpx; line-height: 1; }
.sync-bar__action::after { border: 0; }
.sync-bar__action[disabled] { color: #7c93ac; opacity: .72; }
.sync-action__icon { position: relative; width: 20rpx; height: 20rpx; box-sizing: border-box; border: 3rpx solid currentColor; border-left-color: transparent; border-radius: 50%; }
.sync-action__icon::after { position: absolute; top: -5rpx; left: -4rpx; width: 0; height: 0; border-top: 4rpx solid transparent; border-bottom: 4rpx solid transparent; border-right: 6rpx solid currentColor; content: ""; transform: rotate(35deg); }
.sync-action__icon--spinning { animation: sync-spin .8s linear infinite; }
@keyframes sync-spin { to { transform: rotate(360deg); } }
.route-switch { display: flex; min-height: 44rpx; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; padding: 8rpx 4rpx 0; border-top: 1rpx solid rgba(24,32,40,.07); font-size: 21rpx; }
.route-switch__current,.route-switch__action { display: flex; min-width: 0; align-items: center; gap: 8rpx; white-space: nowrap; }
.route-switch__current { overflow: hidden; color: #69727b; }
.route-switch__current > text:last-child { overflow: hidden; text-overflow: ellipsis; }
.route-switch__eyebrow { flex: none; color: #9aa1a8; }
.route-switch__action { flex: none; font-weight: 600; }
.route-switch__chevron { font-size: 30rpx; font-weight: 300; line-height: 1; }
.wheel-heading { display: flex; justify-content: space-between; margin: 10rpx 10rpx 4rpx; color: #59626c; font-size: 25rpx; }
.wheel-tip { color: #9ba2a9; font-size: 21rpx; }
.station-wheel { position: relative; min-height: 0; flex: 1; overflow: hidden; }
.station-wheel-scroll { width: 100%; height: 100%; min-height: 0; }
.wheel-spacer { position: relative; width: 100%; flex: none; }
.route-end-cap,.loop-boundary { position: absolute; left: 0; }
.route-end-cap { width: 72rpx; }
.loop-boundary { width: 240rpx; }
.route-end-cap--top,.loop-boundary--top { right: auto; bottom: 0; }
.route-end-cap--bottom,.loop-boundary--bottom { top: 0; }
.route-end-cap__line,.loop-boundary__line { position: absolute; left: 34rpx; width: 5rpx; opacity: .72; }
.route-end-cap--top .route-end-cap__line { top: 50%; bottom: 0; }
.route-end-cap--bottom .route-end-cap__line { top: 0; height: 50%; }
.loop-boundary--top .loop-boundary__line { top: 50%; bottom: 0; }
.loop-boundary--bottom .loop-boundary__line { top: 0; height: 50%; }
.route-end-cap__marker { position: absolute; top: 50%; left: 24rpx; z-index: 1; display: flex; width: 24rpx; height: 24rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 5rpx solid; border-radius: 50%; background: #f6f7f8; box-shadow: 0 0 0 5rpx #f6f7f8; transform: translateY(-50%); }
.route-end-cap__core { width: 8rpx; height: 8rpx; flex: none; border-radius: 50%; }
.loop-boundary__ring { position: absolute; top: 50%; left: 20rpx; z-index: 1; width: 34rpx; height: 34rpx; box-sizing: border-box; border: 4rpx solid; border-radius: 50%; background: #f6f7f8; opacity: .92; box-shadow: 0 0 0 5rpx #f6f7f8; transform: translateY(-50%); }
.loop-boundary__arrow { position: absolute; width: 0; height: 0; border-top: 5rpx solid transparent; border-bottom: 5rpx solid transparent; }
.loop-boundary__arrow--forward { top: -6rpx; right: -8rpx; border-left: 8rpx solid; transform: rotate(35deg); }
.loop-boundary__arrow--return { bottom: -6rpx; left: -8rpx; border-right: 8rpx solid; transform: rotate(35deg); }
.loop-boundary__label { position: absolute; top: 50%; left: 68rpx; display: flex; height: 36rpx; align-items: center; color: #8b949d; font-size: 20rpx; font-weight: 500; letter-spacing: .5rpx; white-space: nowrap; transform: translateY(-50%); }
.station-row { position: relative; display: flex; width: 100%; flex: none; align-items: center; box-sizing: border-box; }
.track-column { position: relative; display: flex; width: 72rpx; flex: none; align-self: stretch; align-items: center; justify-content: center; }
.track-line { position: absolute; top: 0; bottom: 0; left: 34rpx; width: 5rpx; opacity: .72; }
.branch-switch-anchor { position: relative; z-index: 4; width: 100%; height: 0; overflow: visible; }
.branch-switch-slot { position: absolute; top: 0; left: 36rpx; display: flex; width: 310rpx; height: 56rpx; box-sizing: border-box; align-items: flex-start; padding: 20rpx 0 0 48rpx; transform: translateY(-50%); }
.branch-switch-slot__diagonal { position: absolute; top: 13rpx; left: 0; width: 28rpx; height: 5rpx; transform: rotate(45deg); transform-origin: left center; opacity: .38; }
.branch-switch-slot__horizontal { position: absolute; top: 33rpx; left: 20rpx; width: 200rpx; height: 5rpx; opacity: .38; }
.branch-switch-slot__label { position: relative; z-index: 1; display: flex; height: 30rpx; align-items: center; gap: 5rpx; padding: 0 9rpx; border-radius: 999rpx; background: rgba(246,247,248,.96); font-size: 19rpx; font-weight: 600; opacity: .82; white-space: nowrap; }
.branch-switch-slot__chevron { font-size: 25rpx; font-weight: 300; line-height: 1; }
.branch-switch-slot--pressed .branch-switch-slot__label { background: #fff; opacity: 1; transform: translateX(3rpx); }
.station-dot { position: relative; z-index: 1; width: 24rpx; height: 24rpx; box-sizing: border-box; border: 5rpx solid; border-radius: 50%; background: #f6f7f8; box-shadow: 0 0 0 5rpx #f6f7f8; }
.location-pin { position: relative; z-index: 2; display: flex; width: 34rpx; height: 34rpx; box-sizing: border-box; align-items: center; justify-content: center; border: 4rpx solid #fff; border-radius: 50% 50% 50% 8rpx; box-shadow: 0 5rpx 14rpx rgba(36,47,58,.2); transform: rotate(-45deg); }
