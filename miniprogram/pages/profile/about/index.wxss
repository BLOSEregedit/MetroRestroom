.about-page { min-height: 100vh; padding: 88rpx 40rpx; box-sizing: border-box; text-align: center; }
.about-mark { width: 96rpx; height: 96rpx; margin: 0 auto 24rpx; border-radius: 30rpx; background: #d84a4a; color: #fff; font-size: 40rpx; line-height: 96rpx; }
.about-title { font-size: 40rpx; font-weight: 600; }
.about-subtitle { margin-top: 10rpx; color: #999; font-size: 26rpx; }
.about-card,.source-card { border-radius: 24rpx; background: #fff; text-align: left; }
.about-card { margin-top: 72rpx; padding: 8rpx 28rpx; }
.info-row { display: flex; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #eee; color: #555; font-size: 26rpx; }
.info-row:last-child { border-bottom: 0; }
.info-value { color: #999; }
.source-card { margin-top: 24rpx; padding: 28rpx; }
.source-title { color: #4c535a; font-size: 27rpx; font-weight: 600; }
.source-copy { display: block; margin-top: 16rpx; color: #7d858d; font-size: 23rpx; line-height: 1.65; }
.source-link { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; color: #b84a4a; font-size: 21rpx; word-break: break-all; }
.source-link__action { flex: none; margin-left: 18rpx; color: #8b939b; }
