.detail-page { min-height: 100vh; padding: 64rpx 40rpx 88rpx; box-sizing: border-box; color: #1f2429; }
.city-hero { padding: 0 8rpx 36rpx; }
.city-hero__eyebrow { color: #e3002b; font-size: 24rpx; font-weight: 600; letter-spacing: 3rpx; }
.city-hero__title { margin-top: 14rpx; font-size: 42rpx; font-weight: 600; line-height: 1.25; }
.city-hero__copy { display: block; margin-top: 18rpx; color: #66717a; font-size: 25rpx; line-height: 1.72; }
.checked-pill { display: inline-flex; min-height: 44rpx; align-items: center; margin-top: 22rpx; padding: 0 18rpx; border: 1rpx solid #d8dde1; border-radius: 999rpx; color: #818991; font-size: 21rpx; }
.detail-section { margin-top: 18rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.section-title { min-width: 0; color: #31383e; font-size: 28rpx; font-weight: 600; }
.source-badge { flex: none; padding: 6rpx 13rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 500; }
.source-badge--official { background: #edf6ed; color: #4e7b4b; }
.source-badge--derived { background: #eef5fb; color: #507797; }
.source-badge--public { background: #f3f1ec; color: #7e7055; }
.section-copy { display: block; margin-top: 16rpx; color: #707981; font-size: 24rpx; line-height: 1.75; }
.section-copy--continued { margin-top: 12rpx; }
.links-title { margin: 44rpx 8rpx 16rpx; color: #8a929a; font-size: 23rpx; }
.links-card { overflow: hidden; border-radius: 24rpx; background: #fff; }
.source-link-row { display: flex; min-height: 108rpx; align-items: center; margin-left: 28rpx; padding: 22rpx 28rpx 22rpx 0; border-bottom: 1rpx solid #eee; box-sizing: border-box; }
.source-link-row:last-child { border-bottom: 0; }
.source-link-row--pressed { opacity: 0.55; }
.source-link-row__body { min-width: 0; flex: 1; }
.source-link-row__title { color: #424a51; font-size: 25rpx; font-weight: 600; }
.source-link-row__publisher { display: block; margin-top: 7rpx; overflow: hidden; color: #8b939b; font-size: 21rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.source-link-row__action { flex: none; margin-left: 20rpx; color: #007aff; font-size: 23rpx; }
.page-back-action { display: flex; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 34rpx; color: #007aff; font-size: 28rpx; font-weight: 500; }
.page-back-action--pressed { opacity: 0.55; }
