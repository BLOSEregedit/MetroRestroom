.profile-page { min-height: 100vh; box-sizing: border-box; padding: 12rpx 32rpx 56rpx; }
.section-title { margin: 28rpx 8rpx 18rpx; color: #777; font-size: 25rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.clear-action { margin: 28rpx 8rpx 18rpx; color: #007aff; font-size: 24rpx; }
.empty-card, .settings-card { border-radius: 24rpx; background: #fff; }
.empty-card { padding: 58rpx 30rpx; text-align: center; }
.empty-icon { color: #007aff; font-size: 48rpx; }
.empty-title { margin-top: 16rpx; font-size: 30rpx; }
.empty-description, .setting-description { color: #999; font-size: 24rpx; }
.empty-description { margin-top: 10rpx; }
.setting-row, .about-row, .correction-row, .sync-row { display: flex; align-items: center; justify-content: space-between; }
.setting-row { min-height: 112rpx; padding: 0 28rpx; }
.setting-title { font-size: 29rpx; }
.divider { height: 1rpx; margin: 0 28rpx; background: #eee; }
.about-row { padding: 28rpx; }
.correction-row { padding: 28rpx; }
.sync-row { min-height: 100rpx; box-sizing: border-box; padding: 0 28rpx; }
.sync-value { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: flex-end; gap: 10rpx; margin-left: 20rpx; color: #77808a; font-size: 22rpx; text-align: right; }
.sync-value__message { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sync-value__dot { width: 12rpx; height: 12rpx; flex: none; border-radius: 50%; background: #77808a; }
.sync-value--green { color: #247f56; }
.sync-value--green .sync-value__dot { background: #29a36a; }
.sync-value--blue .sync-value__dot { background: #007aff; }
.recent-card { overflow: hidden; }
.recent-row { display: flex; min-height: 108rpx; align-items: center; justify-content: space-between; padding: 0 28rpx; border-bottom: 1rpx solid #eee; }
.recent-row:last-child { border-bottom: 0; }
.recent-toggle { min-height: 88rpx; background: #fafafa; color: #007aff; font-size: 26rpx; line-height: 88rpx; text-align: center; }
.chevron { color: #aaa; font-size: 42rpx; font-weight: 200; }
