<view class="tab-bar">
  <view class="tab-bar__content">
    <view wx:for="{{tabs}}" wx:key="pagePath" class="tab-bar__item {{selected === index ? 'tab-bar__item--selected' : ''}}" aria-label="{{item.text}}" data-index="{{index}}" data-page-path="{{item.pagePath}}" bindtap="onSwitchTab">
      <image class="tab-bar__icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
    </view>
  </view>
</view>
